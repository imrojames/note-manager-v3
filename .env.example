# ----- API (apps/api) -----
PORT=4000
NODE_ENV=development

# MongoDB connection string. Matches the docker-compose credentials below.
MONGODB_URI=mongodb://root:example@localhost:27017/note-manager?authSource=admin

# Auth
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# CORS: the web origin allowed to call the API
CORS_ORIGIN=http://localhost:5173

# ----- MongoDB (docker-compose) -----
MONGO_USER=root
MONGO_PASSWORD=example

# ----- Web (apps/web) -----
VITE_API_URL=http://localhost:4000
